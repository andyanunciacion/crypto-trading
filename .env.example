# Copy to .env and fill in real values. .env is git-ignored: never commit it.
# The API and engine validate these at startup (shared/src/shared/config.py) and
# exit with a list of anything missing or invalid.

# Global live gate (D17): paper | live. Leave on paper; while it is paper,
# no bot can trade real money.
MODE=paper

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Postgres: the db container creates this user and database on first start.
# Required: the API and engine refuse to start without them.
POSTGRES_USER=crypto
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crypto_trading
# Where the API and engine find Postgres. The defaults suit Docker Compose.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis, for live prices and commands. The default suits Docker Compose.
REDIS_URL=redis://redis:6379/0

# --- The API's secrets (D44). Required by the API; the engine doesn't use them. ---
# Signs the dashboard's session cookies: anyone with it can sign in. At least 32 characters.
# Make one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Encrypts secrets kept in the database (the TOTP secret; exchange keys from P5-7). Changing
# it makes them unreadable: then reset-totp. Make one (a Fernet key):
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# How long a dashboard sign-in lasts, in hours.
SESSION_HOURS=12
# How often the dashboard's Overview refreshes, in seconds (D45).
FEED_SECONDS=1
# How long the dashboard's kill switch waits for the engine's reply, in seconds.
KILL_REPLY_SECONDS=10

# Host ports for the API and the dashboard (127.0.0.1 only). The e2e tests' own stack
# uses 8100 and 3100, so it can run beside this one.
API_PORT=8000
FRONTEND_PORT=3000

# Symbols whose live price the engine streams into Redis, comma-separated (CCXT format).
# The running bots' symbols are streamed too; this list adds any others.
PRICE_SYMBOLS=BTC/USDT
