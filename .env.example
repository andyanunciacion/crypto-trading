# Copy to .env and fill in real values. .env is git-ignored: never commit it.
# The API and engine validate these at startup (shared/src/shared/config.py) and
# exit with a list of anything missing or invalid.

# Global live gate (D17): paper | live. Leave on paper; while it is paper,
# no bot can trade real money.
MODE=paper

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Postgres: the db container creates this user and database on first start.
# Required: the API and engine refuse to start without them.
POSTGRES_USER=crypto
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crypto_trading
# Where the API and engine find Postgres. The defaults suit Docker Compose.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis, for live prices and commands. The default suits Docker Compose.
REDIS_URL=redis://redis:6379/0

# Symbols whose live price the engine streams into Redis, comma-separated (CCXT format).
PRICE_SYMBOLS=BTC/USDT
